# SQLite in development. Point at Postgres/MySQL and change the provider in
# prisma/schema.prisma for production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the app, used in invitation emails. Include the sub-path if
# you deploy under one (e.g. https://example.com/dataroom).
APP_URL="http://localhost:3000"

# Serve the app under a sub-path. Must match the APP_URL path and is baked in
# at build time. Leave empty to serve from the domain root.
BASE_PATH=""

# Port for `npm start` (the reverse proxy forwards to it).
PORT="3000"

# Where uploaded files are stored (relative to the project root or absolute).
STORAGE_DIR="./storage"

# Max upload size in megabytes.
MAX_UPLOAD_MB="100"

# Optional SMTP for invitation + notification emails, e.g.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# When unset, emails are printed to the server console and invite links can
# be copied from the People tab.
SMTP_URL=""
EMAIL_FROM="Data Room <noreply@example.com>"

# Set to "false" to stop new owner accounts from registering.
ALLOW_SIGNUP="true"
