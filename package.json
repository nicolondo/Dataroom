    "db:studio": "prisma studio",
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
