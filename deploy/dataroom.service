[Unit]
Description=Data Room (Next.js)
After=network.target

[Service]
Type=simple
User=dataroom
Group=dataroom
WorkingDirectory=/opt/dataroom
EnvironmentFile=/opt/dataroom/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dataroom

[Install]
WantedBy=multi-user.target
